# FOCUS (vim-style, cross-display)
#ralt - a : yabai -m window --focus west  || yabai -m display --focus west
#ralt - d : yabai -m window --focus east  || yabai -m display --focus east
#ralt - w : yabai -m window --focus north || yabai -m display --focus north
#ralt - s : yabai -m window --focus south || yabai -m display --focus south

# SWAP WINDOWS (arrow keys = physical move, vim keys = focus)
ralt - a  : yabai -m window --swap west
ralt - d : yabai -m window --swap east
ralt - w    : yabai -m window --swap north
ralt - s  : yabai -m window --swap south

# RESIZE WINDOWS
ralt + shift - a : yabai -m window --resize left:-50:0
ralt + shift - d : yabai -m window --resize right:50:0
ralt + shift - w : yabai -m window --resize top:0:-50
ralt + shift - s : yabai -m window --resize bottom:0:50

# LAYOUT CONTROL
# Toggle zoom fullscreen.
ralt - f : yabai -m window --toggle zoom-fullscreen
ralt - t : yabai -m window --toggle float
ralt - q : yabai -m window --close
ralt - c : yabai -m window --grid 4:4:1:1:2:2  # center float (rough center)

# Rotate / rebalance tree
ralt - r : yabai -m space --rotate 90
ralt - e : yabai -m space --balance

# Toggle split orientation of window pair
ralt - x : yabai -m window --toggle split

# Mirror space on axes
ralt - m           : yabai -m space --mirror x-axis
shift + ralt - m   : yabai -m space --mirror y-axis

# Toggle gaps/padding
ralt - g : yabai -m space --toggle padding && yabai -m space --toggle gap

# SPACES (WORKSPACES)
ralt - 1 : yabai -m space --focus 1
ralt - 2 : yabai -m space --focus 2
ralt - 3 : yabai -m space --focus 3
ralt - 4 : yabai -m space --focus 4
ralt - 5 : yabai -m space --focus 5
ralt - 6 : yabai -m space --focus 6
ralt - 7 : yabai -m space --focus 7
ralt - 8 : yabai -m space --focus 8

# SWAP SPACES (desktop order)
ralt + cmd - 1 : yabai -m space --swap 1
ralt + cmd - 2 : yabai -m space --swap 2
ralt + cmd - 3 : yabai -m space --swap 3
ralt + cmd - 4 : yabai -m space --swap 4
ralt + cmd - 5 : yabai -m space --swap 5
ralt + cmd - 6 : yabai -m space --swap 6
ralt + cmd - 7 : yabai -m space --swap 7
ralt + cmd - 8 : yabai -m space --swap 8

# Move window to space (and follow, keeping focus on moved window)
shift + ralt - 1 : id=$(yabai -m query --windows --window | jq '.id') && yabai -m window --space 1 && yabai -m space --focus 1 && yabai -m window --focus "$id"
shift + ralt - 2 : id=$(yabai -m query --windows --window | jq '.id') && yabai -m window --space 2 && yabai -m space --focus 2 && yabai -m window --focus "$id"
shift + ralt - 3 : id=$(yabai -m query --windows --window | jq '.id') && yabai -m window --space 3 && yabai -m space --focus 3 && yabai -m window --focus "$id"
shift + ralt - 4 : id=$(yabai -m query --windows --window | jq '.id') && yabai -m window --space 4 && yabai -m space --focus 4 && yabai -m window --focus "$id"
shift + ralt - 5 : id=$(yabai -m query --windows --window | jq '.id') && yabai -m window --space 5 && yabai -m space --focus 5 && yabai -m window --focus "$id"
shift + ralt - 6 : id=$(yabai -m query --windows --window | jq '.id') && yabai -m window --space 6 && yabai -m space --focus 6 && yabai -m window --focus "$id"
shift + ralt - 7 : id=$(yabai -m query --windows --window | jq '.id') && yabai -m window --space 7 && yabai -m space --focus 7 && yabai -m window --focus "$id"
shift + ralt - 8 : id=$(yabai -m query --windows --window | jq '.id') && yabai -m window --space 8 && yabai -m space --focus 8 && yabai -m window --focus "$id"

# Move window to prev/next space (and follow)
shift + ralt - p : yabai -m window --space prev && yabai -m space --focus prev
shift + ralt - n : yabai -m window --space next && yabai -m space --focus next

# Create / destroy spaces
rcmd + ralt - n : "$HOME/.config/yabai/create-space-right.sh"
rcmd + ralt - r : "$HOME/.config/yabai/destroy-empty-space.sh"

# Workspace profiles
rcmd + ralt + shift - 1 : "$HOME/.config/yabai/workspaces/main-workspace.sh"
rcmd + ralt + shift - 0 : "$HOME/.config/yabai/workspaces/reset-workspace.sh"

# OPEN APPS
ralt - return : osascript -e 'tell application "Ghostty" to «event GhstNWin»' || open -a Ghostty
ralt + shift - return : open -na Ghostty --args -e zsh -ic n
ralt - z : zed -n
ralt - v : code -n
ralt - b : osascript -e 'tell application "Finder" to make new Finder window' -e 'tell application "Finder" to activate'

# Switch desktops (default macOs shortcuts  for Mission Control)
ctrl - left : yabai -m space --focus prev
ctrl - right : yabai -m space --focus next

# Alt tabbing — loops through all windows, wraps around
ralt - tab : yabai -m window --focus next || yabai -m window --focus first
ralt + shift - tab : yabai -m window --focus prev || yabai -m window --focus last
